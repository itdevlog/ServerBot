# Секреты ServerBot. Скопируйте в bot.env и заполните. bot.env не коммитится.

# Токен бота от @BotFather.
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Секреты, на которые ссылается config.yaml через ${...}.
# Имена должны совпадать с плейсхолдерами в config.yaml.
WEB1_PASS=change-me
DB1_PASSPHRASE=change-me
